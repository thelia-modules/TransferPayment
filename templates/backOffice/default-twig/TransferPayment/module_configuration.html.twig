{% if app.request.query.get('errmes') %}
    <div class="alert alert-danger">
        {{ app.request.query.get('errmes') }}
    </div>
{% endif %}

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'Enter your BIC information'|trans({}, 'transferpayment') }}</h5>
    </div>
    <div class="card-body">
        {{ form_start(form, {action: path('transferpayment'), method: 'POST'}) }}

            {{ form_errors(form) }}

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name, {attr: {class: 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.iban) }}
                    {{ form_widget(form.iban, {attr: {class: 'form-control' ~ (form.iban.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.iban) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.bic) }}
                    {{ form_widget(form.bic, {attr: {class: 'form-control' ~ (form.bic.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.bic) }}
                </div>
                <div class="col-md-12 mb-3">
                    <div class="form-check">
                        {{ form_widget(form.sendEmail, {attr: {class: 'form-check-input'}}) }}
                        {{ form_label(form.sendEmail, null, {label_attr: {class: 'form-check-label'}}) }}
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                {{ 'Save changes'|trans({}, 'transferpayment') }}
            </button>

        {{ form_end(form) }}
    </div>
</div>
